spring:
  application:
    name: kb-qdrant-springboot
  mvc:
    async:
      request-timeout: 120000  # 2分钟超时
  servlet:
    multipart:
      max-file-size: 25MB
      max-request-size: 50MB
  # MySQL数据源配置
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/kb_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: 你的MySQL密码

server:
  port: 8080
  tomcat:
    relaxed-query-chars: '[,]'
    relaxed-path-chars: '[,]'
    # 增加连接超时时间
    connection-timeout: 60000
    connection-upload-timeout: 60000
    # 允许更多字符（仅用于开发环境）
    connector:
      parse-body-methods: POST,PUT,DELETE

# DeepSeek API Configuration
anthropic:
  api-key: ${CLAUDE_API_KEY:你的API密钥}
  base-url: https://model-api.datagrand.com
  model: deepseek-v4-pro
  max-tokens: 4096
  temperature: 0.7
  # 禁用API嵌入调用以减少404错误
  enable-embedding: false

# Web Search Configuration
search:
  enabled: true
  timeout: 60000  # 增加到60秒
  user-agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# 知识库系统配置
kb:
  upload-sub-dir: kb_upload
  chunk-size: 500
  chunk-overlap: 100

# BGE本地嵌入配置
bge:
  embedding:
    enabled: true
    model-path: models/bge-small-zh.onnx
    vector-size: 384  # BGE-small-zh的标准向量维度
    max-length: 512
    use-gpu: false

# Qdrant配置
qdrant:
  host: 127.0.0.1
  port: 6333
  collection-name: kb_collection
  vector-size: 384  # 与BGE-small-zh模型的向量维度匹配

# Ollama Embedding配置 (已禁用，使用DeepSeek API)
ollama:
  enabled: false
  base-url: http://127.0.0.1:11434
  embedding-model: bge-small-zh

# MyBatis Plus配置
mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

# ==================== 网上商店配置 ====================
shop:
  # 商品图片上传目录（相对项目根目录）
  upload-dir: shop_upload

# 支付宝沙箱配置（信息来自支付宝开放平台沙箱环境）
# 应用私钥与支付宝公钥请在 https://open.alipay.com -> 控制台 -> 沙箱环境
# 「开发信息 -> 接口加签方式(系统默认密钥/公钥模式)」点击"查看"获取：
#   - 应用私钥（Java版 PKCS8 格式）填入 merchant-private-key
#   - 支付宝公钥填入 alipay-public-key
alipay:
  app-id: 9021000169626849
  gateway-url: https://openapi-sandbox.dl.alipaydev.com/gateway.do
  merchant-private-key: CHANGE_ME_应用私钥_PKCS8
  alipay-public-key: CHANGE_ME_支付宝公钥
  # 商家账号PID（异步通知校验卖家身份用）
  seller-id: 2088721115700271
  sign-type: RSA2
  # 异步通知地址（支付宝服务器回调，本地开发无法被公网访问，
  # 可用 natapp/ngrok 等内网穿透替换；不穿透时依赖同步跳转+主动查单）
  notify-url: ${ALIPAY_NOTIFY_URL:http://localhost:8080/api/shop/alipay/notify}
  # 支付完成后浏览器同步跳转地址（前端页面）
  return-url: http://localhost:5173/?payReturn=1

